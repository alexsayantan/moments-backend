APP_NAME="User Service"
APP_VERSION="v1"
APP_DESCRIPTION="User management service"

# PostgreSQL connection string (using psycopg 3)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/user_db
ECHO_SQL=false

# Kubernetes & AWS RDS Proxy connection pool tuning
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300
# DB_PREPARE_THRESHOLD=null # Keep null/unset to disable prepared statements and prevent RDS Proxy connection pinning
